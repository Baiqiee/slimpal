# 统一换行与二进制判定，避免 Windows / macOS / Linux 之间来回改行尾
* text=auto

# Windows 批处理必须是 CRLF，否则可能执行异常
*.bat text eol=crlf
*.cmd text eol=crlf
# Shell 脚本必须 LF
*.sh text eol=lf
gradlew text eol=lf

# 二进制：不要让 Git 做行尾转换或 diff
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.apk binary
*.aab binary
*.zip binary
*.7z binary
*.jar binary
*.keystore binary
*.jks binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.onnx binary
