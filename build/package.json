{
  "name": "jianfeiji",
  "productName": "减肥姬",
  "version": "1.0.0",
  "description": "本地减肥陪伴 App —— 不联网、不登录，数据只存在你自己的设备上",
  "main": "main.js",
  "private": true,
  "author": "personal",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.jianfeiji.desktop",
    "productName": "减肥姬",
    "disableAsarIntegrity": true,
    "directories": {
      "output": "../dist",
      "buildResources": "."
    },
    "files": [
      "main.js",
      "preload.js",
      "desktop-core.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "webapp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "executableName": "JianfeiJi"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "减肥姬",
      "artifactName": "减肥姬-${version}-安装程序.${ext}",
      "uninstallDisplayName": "减肥姬"
    }
  }
}
