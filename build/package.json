{
  "name": "slimpal",
  "productName": "SlimPal",
  "version": "1.2.0",
  "description": "SlimPal — 本地减肥陪伴 App。不联网、不登录，数据只存在你自己的设备上",
  "main": "main.js",
  "private": true,
  "author": "baiqiee",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.slimpal.desktop",
    "productName": "SlimPal",
    "directories": {
      "output": "../dist",
      "buildResources": "."
    },
    "files": [
      "main.js",
      "preload.js",
      "desktop-core.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "webapp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "executableName": "SlimPal"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SlimPal",
      "artifactName": "SlimPal-${version}-Setup.${ext}",
      "uninstallDisplayName": "SlimPal"
    }
  }
}
